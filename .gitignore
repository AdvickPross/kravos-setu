# Corpus data -- huge, regenerable (scripts/build_lexicon.py, scripts/split_facts.py),
# and over GitHub's file-size limits. patients.jsonl and lexicon.csv stay
# tracked: small, and useful without regenerating anything.
facts.jsonl
facts.zip
facts_by_patient/
synthea-with-dependencies.jar

# ABHA <-> patient tagging map (backend/abha_link.py). ABHA numbers are
# health identifiers; committing the map would publish exactly the linkage
# the module exists to protect. Regenerated by use, never by a script.
data/abha_links.json

# Secrets -- never commit real credentials, only the .example templates.
# *.local.md: private handoff notes (e.g. M2 sandbox onboarding) -- shared
# person to person, never through the repo.
*.local.md
.env
.env.local
frontend/.env.local

# Python
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
models/cache/

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/tsconfig.tsbuildinfo

# Claude Code local settings (machine-specific, not shared)
.claude/settings.local.json
