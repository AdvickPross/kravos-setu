# Copy to .env and fill in. Never commit the real .env.

# Only needed if KRAVOS_LLM_POLISH_ENABLED is on -- the templated brief
# (backend/brief.py) works fully without this.
ANTHROPIC_API_KEY=

# Off by default. The demo must work completely with this unset/false --
# backend/llm_polish.py falls back to the unmodified templated brief on
# any failure (disabled, no key, timeout, API error).
KRAVOS_LLM_POLISH_ENABLED=false

# Stage 2 (Pinecone REPORT-category vector search, narrative fallback only).
# Unset/empty means the fallback is skipped entirely -- retrieve() degrades
# to what it already does today. Run scripts/index_reports.py once a key is
# set, before the fallback has anything to find.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=kravos-reports

# Conversational RAG (backend/conversation.py, POST /api/chat). Unset means
# /api/chat answers 503 -- the rest of the API is unaffected, same pattern
# as the ABDM routes below. Model checked against this account's actual
# /openai/v1/models listing -- see backend/groq_client.py's docstring
# before changing it.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# --- M1: ABDM ABHA V3 (identity) ------------------------------------------
# From https://sandbox.abdm.gov.in after registering as an integrator. These
# are credentials: they belong in .env, which is gitignored, and never in a
# committed file, a Dockerfile, or the frontend bundle.
#
# Leave them blank and everything else still works -- /api/abha/* answers 503
# with a message naming this file, and the rest of the API is unaffected.
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=

# sandbox | production. Not just a base URL swap: the gateway, ABHA and PHR
# hosts all differ between the two, and production also flips X-CM-ID from
# 'sbx' to 'abdm'. See abha/config.py.
ABDM_ENVIRONMENT=sandbox
ABDM_TIMEOUT_SECONDS=30

# --- M2: Building HIP --------------------------------------------------------
# The facility id this bridge is registered under (HFR / sandbox bridge
# registration). Sent as X-HIP-ID; inbound callbacks for any other HIP are
# refused. M2 routes answer 503 until it is set.
ABDM_HIP_ID=
# Inbound /api/v3/hip/* callbacks must carry a gateway-signed JWT. Set to
# false ONLY to curl the callbacks locally -- never on a public bridge URL.
ABDM_VERIFY_GATEWAY_TOKENS=true
# How the user-initiated linking OTP reaches the patient. 'log' (the only
# mode so far) writes it to the server log for sandbox demos; production
# needs a real SMS provider wired into backend/m2_service.deliver_otp.
ABDM_OTP_DELIVERY=log
